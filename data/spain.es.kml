				<coordinates>-3.677972071710044,40.41324585920941,0</coordinates>
			</Point>
		</Placemark>
		<Placemark>
			<name>Ría Sur y cascada de la Chopera</name>
			<description>Esta ría data de 1900 y tiene una longitud de unos 200 metros que termina sobre una rocalla produciendo la cascada que le da nombre.</description>
			<LookAt>
				<longitude>-3.68728442680814</longitude>
				<latitude>40.41136841746741</latitude>
				<altitude>0</altitude>

				<coordinates>-3.680296333985538,40.41805538549541,0</coordinates>
			</Point>
		</Placemark>
		<Placemark>
			<name>Quiosco de música</name>
			<description>Templete de música donde la banda municipal de Madrid realiza conciertos al público los domingos por la mañana.</description>
			<LookAt>
				<longitude>-3.68501500585371</longitude>

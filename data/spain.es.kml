			</Point>
		</Placemark>
		<Placemark>
			<name>Cedro del Libano</name>
			<description>Cedro del Libano.
Se trata del árbol nacional  de ese país.
Ejemplar de más de 120 años.</description>
			<LookAt>
				<longitude>-3.680888221750388</longitude>
				<latitude>40.41726359286847</latitude>

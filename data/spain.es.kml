				<coordinates>-3.681287039224674,40.41395996960669,0</coordinates>
			</Point>
		</Placemark>
		<Placemark>
			<name>Palmera de la fortuna</name>
			<description>Es originaria de China.
Tolera muy bien ambos extremos de temperatura.
La infusión de sus raíces tiene propiedades astingentes y se utilizaba como anticonceptivo en su zona de origen.</description>
			<LookAt>
				<longitude>-3.681507680546217</longitude>
				<latitude>40.41264964237387</latitude>
				<altitude>0</altitude>
				<heading>0</heading>
